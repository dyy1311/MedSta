# 复制为 .env 并填写（OpenAI 兼容接口，可接 GLM/DeepSeek/vLLM/Ollama 等）
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_API_KEY=your-api-key-here
LLM_MODEL=glm-4-flash

# 可选：请求超时（秒）
LLM_TIMEOUT=120

# 可选：结果解读（默认开启；设为 0 关闭，交付链路不受影响）
MEDSTA_INTERPRET=1
# 可选：每步结论最大句数（默认 1，clamp 到 1–5）
MEDSTA_INTERPRET_MAX_SENTENCES=1

# 可选：访问令牌鉴权（留空/不设 = 关闭，行为与单机模式一致）。
# 设置后所有 HTTP 请求需带 X-Auth-Token 或 Authorization: Bearer <token>（/health 豁免），
# WebSocket 连接需带 ?token=<token>；适合局域网/公网部署前开启。
# MEDSTA_AUTH_TOKEN=change-me
